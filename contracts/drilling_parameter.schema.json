{
  "$defs": {
    "SourceMetadata": {
      "additionalProperties": true,
      "description": "Metadata identifying where and when an ingested record originated.",
      "properties": {
        "source_type": {
          "enum": [
            "csv",
            "json",
            "pdf",
            "api",
            "database",
            "sample"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "source_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Record Id"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "source_name"
      ],
      "title": "SourceMetadata",
      "type": "object"
    }
  },
  "description": "Canonical drilling/mud parameter observation.",
  "properties": {
    "source_metadata": {
      "$ref": "#/$defs/SourceMetadata"
    },
    "well_id": {
      "minLength": 1,
      "title": "Well Id",
      "type": "string"
    },
    "observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed At"
    },
    "depth": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Depth"
    },
    "rop": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rop"
    },
    "wob": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wob"
    },
    "rpm": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rpm"
    },
    "torque": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Torque"
    },
    "hookload": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hookload"
    },
    "mud_weight": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mud Weight"
    },
    "mud_flow_rate": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mud Flow Rate"
    },
    "standpipe_pressure": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Standpipe Pressure"
    },
    "pump_pressure": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pump Pressure"
    },
    "temperature": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "bit_size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bit Size"
    },
    "bit_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bit Type"
    }
  },
  "required": [
    "source_metadata",
    "well_id"
  ],
  "title": "DrillingParameter",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-nwis-source-model": "ingestion.models.entities.DrillingParameter"
}